POSTGRES_DB=autoparts_pos
POSTGRES_USER=autoparts_user
POSTGRES_PASSWORD=change_me_strong_password

# URL used by backend CORS (the browser origin of your frontend).
# Use the exact public URL configured in Coolify.
FRONTEND_URL=https://app.example.com

# The frontend and API share one domain in this deployment.
# This is baked into the frontend image during the Docker build.
VITE_API_URL=/
